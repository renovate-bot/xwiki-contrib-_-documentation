  <name>ComputedURLField</name>
  <language/>
  <defaultLanguage/>
  <translation>0</translation>
  <creator>xwiki:XWiki.Admin</creator>
  <parent>WebHome</parent>
  <author>xwiki:XWiki.Admin</author>
  <contentAuthor>xwiki:XWiki.Admin</contentAuthor>
  <version>1.1</version>
  <title>ComputedURLField</title>
  <comment/>
  <minorEdit>false</minorEdit>
  <syntaxId>xwiki/2.1</syntaxId>
  <hidden>true</hidden>
  <content>{{velocity}}
#macro (computedConfluenceURLField $pageFieldName $pageAnchorFieldName $urlFieldName)
  #set ($res = [])
  #set ($urls = $doc.getValue($urlFieldName))
  #if ($objecttool.isNotNull($urls))
    #if ($urls.class.name == 'String')
      #if ("$!urls" != "")
        #set ($discard = $res.add($urls))
      #end
    #else
      #set ($discard = $res.addAll($urls))
    #end
  #end
  #set ($pages = $doc.getValue($pageFieldName))
  #if ($objecttool.isNull($pages))
    #set ($pages = [])
  #end
  #set ($pageAnchors = $doc.getValue($pageAnchorFieldName))
  #if ($objecttool.isNull($pageAnchors))
    #set ($pageAnchors = [])
  #end
  #if ($pages.class.name == 'java.lang.String')
    #set ($pages = [$pages])
  #end
  #if ($pageAnchors.class.name == 'java.lang.String')
    #set ($pageAnchors = [$pageAnchors])
  #end
  #set ($n = $pages.size() - 1)
  #if ($n &gt;= 0)
    #foreach ($index in [0..$n])
      #set ($page = $pages.get($index))
      #if ("$!page" != "")
        #set ($pageAnchor = "")
        #if ($index &lt; $pageAnchors.size())
          #set ($pageAnchor = $pageAnchors.get($index))
        #end
        #if ("$!pageAnchor" == "")
          #set ($anchor = "")
        #else
          #set ($anchor = "#" + $pageAnchor)
        #end
        #set ($discard = $res.add($xwiki.getURL($page) + $anchor))
      #end
    #end
  #end
  $services.rendering.escape($jsontool.serialize($res), 'xwiki/2.1')
#end
{{/velocity}}</content>
</xwikidoc>
